# Database
DATABASE_URL=postgresql+asyncpg://scrooge:scrooge_secret@localhost:5432/scrooge_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin (first admin invite code)
ADMIN_INVITE_CODE=SCROOGE-ADMIN-2024

# Steam API
STEAM_API_KEY=your-steam-api-key-here

# Scraper
SCRAPE_INTERVAL_MINUTES=30
MAX_CONCURRENT_SCRAPERS=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Proxy (optional)
PROXY_URL=
PROXY_ROTATION_ENABLED=false

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
